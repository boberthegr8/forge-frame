# Copy to .env.local for local dev with `vercel dev`, or set these in the
# Vercel project's Environment Variables for production.

# "anthropic" or "gemini" — picks which key/models below are used.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model used for image-input calls (aiReview on plan pages, etc.)
AI_MODEL_VISION=claude-opus-4-1-20250805
# Model used for text-only calls (aiFirstPass, aiMatch)
AI_MODEL_TEXT=claude-sonnet-4-5-20250929
